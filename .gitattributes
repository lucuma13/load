# Default for all files
* text=auto eol=lf

# No EOL conversion (kept byte-exact)
tests/fixtures/**  -text
src/data/**        -text

# Files that will always have CRLF line endings
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.ahk  text eol=crlf
